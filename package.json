{
  "name": "workdesk",
  "version": "0.1.0",
  "private": true,
  "description": "A local, context-aware developer dashboard orchestrated through Codex CLI.",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "predev": "pnpm --filter @workdesk/shared build",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @workdesk/api dev\" \"pnpm --filter @workdesk/web dev\"",
    "dev:api": "pnpm --filter @workdesk/api dev",
    "dev:web": "pnpm --filter @workdesk/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "workdesk": "node packages/cli/dist/index.js",
    "mcp": "node packages/mcp/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
